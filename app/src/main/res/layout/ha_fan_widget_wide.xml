<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fan_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/fan_title_badge"
        android:contentDescription="@string/fan_widget_name"
        android:padding="6dp"
        android:src="@drawable/ic_fan_on" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1.20"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fan_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/fan_panel_title"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/fan_widget_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="11sp" />
            <View
                android:id="@+id/fan_widget_connection_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/fan_connection_dot" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/fan_discrete_speed_1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="0.36"
        android:gravity="center"
        android:text="1"
        android:textColor="#1E293B"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/fan_discrete_speed_2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:layout_weight="0.40"
        android:gravity="center"
        android:text="2"
        android:textColor="#1E293B"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/fan_discrete_speed_3"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="0.36"
        android:gravity="center"
        android:text="3"
        android:textColor="#1E293B"
        android:textSize="22sp" />

    <LinearLayout
        android:id="@+id/fan_speed_tile"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="0.68"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/child_lock"
            android:src="@drawable/ic_lock" />
        <TextView
            android:id="@+id/fan_speed_tile_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#475569"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fan_natural_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="0.68"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/fan_natural_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/fan_natural"
            android:src="@drawable/ic_wind" />
        <TextView
            android:id="@+id/fan_natural_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fan_natural"
            android:textColor="#475569"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fan_sleep_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="0.68"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/fan_sleep_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/fan_sleep"
            android:src="@drawable/ic_sleep" />
        <TextView
            android:id="@+id/fan_sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fan_sleep"
            android:textColor="#475569"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fan_power_tile"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="0.68"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/fan_power_tile_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/fan_power"
            android:src="@drawable/ic_power" />
        <TextView
            android:id="@+id/fan_power_tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fan_power"
            android:textColor="#475569"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fan_widget_speed"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/fan_widget_icon"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
