<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fan_card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/fan_title_badge"
            android:contentDescription="@string/fan_widget_name"
            android:padding="4dp"
            android:src="@drawable/ic_fan_on" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/fan_panel_title"
            android:textColor="#1E293B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/fan_widget_connection_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/fan_connection_dot" />

        <TextView
            android:id="@+id/fan_widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

