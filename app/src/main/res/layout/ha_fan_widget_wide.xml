<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fan_card_background"
    android:gravity="center_vertical"
    android:id="@+id/fan_widget_root"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Kept invisible for shared provider compatibility; this widget is controls-only. -->
    <TextView
        android:id="@+id/fan_widget_title"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/fan_widget_state"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/fan_widget_connection_dot"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fan_discrete_speed_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#1E293B"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/fan_discrete_speed_2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:text="2"
        android:textColor="#1E293B"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/fan_discrete_speed_3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:text="3"
        android:textColor="#1E293B"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/fan_speed_tile"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/child_lock"
            android:src="@drawable/ic_lock" />
        <TextView
            android:id="@+id/fan_speed_tile_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#475569"
            android:maxLines="1"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fan_natural_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/fan_natural_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/fan_natural"
            android:src="@drawable/ic_wind" />
        <TextView
            android:id="@+id/fan_natural_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fan_natural"
            android:textColor="#475569"
            android:maxLines="1"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fan_sleep_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/fan_sleep_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/fan_sleep"
            android:src="@drawable/ic_sleep" />
        <TextView
            android:id="@+id/fan_sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fan_sleep"
            android:textColor="#475569"
            android:maxLines="1"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fan_power_tile"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/fan_power_tile_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/fan_power"
            android:src="@drawable/ic_power" />
        <TextView
            android:id="@+id/fan_power_tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fan_power"
            android:textColor="#475569"
            android:maxLines="1"
            android:textSize="7sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fan_widget_speed"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/fan_widget_icon"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
