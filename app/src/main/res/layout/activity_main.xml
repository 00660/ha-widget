<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="风扇挂件设备"
        android:textAppearance="@android:style/TextAppearance.Material.Headline"
        android:textColor="#0F172A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="每个名称就是桌面挂件显示的设备名。"
        android:textAppearance="@android:style/TextAppearance.Material.Body1"
        android:textColor="#475569" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="设备 1"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/esphome_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="ESPHome 地址，例如 http://192.168.2.64"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/fan_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="桌面显示名称，例如 客厅风扇"
        android:inputType="text" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="设备 2" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" />

    <EditText android:id="@+id/esphome_url_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ESPHome 地址" android:inputType="textUri" />
    <EditText android:id="@+id/fan_name_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="桌面显示名称" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="设备 3" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" />
    <EditText android:id="@+id/esphome_url_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ESPHome 地址" android:inputType="textUri" />
    <EditText android:id="@+id/fan_name_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="桌面显示名称" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="设备 4" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" />
    <EditText android:id="@+id/esphome_url_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ESPHome 地址" android:inputType="textUri" />
    <EditText android:id="@+id/fan_name_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="桌面显示名称" />

    <Button
        android:id="@+id/save_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="保存并刷新桌面挂件" />
    </LinearLayout>
</ScrollView>
