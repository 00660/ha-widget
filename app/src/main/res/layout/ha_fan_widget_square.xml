            android:id="@+id/fan_power_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/fan_control_primary"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fan_power_tile_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/fan_power"
                android:src="@drawable/ic_power" />

            <TextView
                android:id="@+id/fan_power_tile_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/fan_power"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fan_natural_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/fan_control_secondary"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fan_natural_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/fan_natural"
                android:src="@drawable/ic_wind" />

            <TextView
                android:id="@+id/fan_natural_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/fan_natural"
                android:textColor="#475569"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fan_sleep_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/fan_control_secondary"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fan_sleep_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/fan_sleep"
                android:src="@drawable/ic_sleep" />

            <TextView
                android:id="@+id/fan_sleep_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/fan_sleep"
                android:textColor="#475569"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

