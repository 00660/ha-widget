<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/entity_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/entity_widget_card"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/entity_widget_background"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/entity_widget_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="设备"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/entity_widget_online_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:background="@drawable/entity_widget_online_dot" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginEnd="18dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/entity_widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#30343B"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/entity_widget_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8B919B"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/entity_widget_state"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/entity_widget_power"
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/entity_widget_state_on"
            android:contentDescription="切换设备" />
    </FrameLayout>
</FrameLayout>
