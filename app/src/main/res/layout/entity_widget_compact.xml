<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/entity_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <ImageView
        android:id="@+id/entity_widget_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/fan_title_badge"
        android:padding="8dp"
        android:contentDescription="设备" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/entity_widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/entity_widget_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/entity_widget_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/entity_widget_power"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="开"
        android:textColor="#2563EB"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
