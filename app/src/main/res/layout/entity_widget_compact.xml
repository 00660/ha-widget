<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/entity_widget_root"
        android:layout_width="64dp"
        android:layout_height="68dp"
        android:layout_gravity="top|start"
        android:background="@drawable/entity_widget_background"
        android:padding="6dp">

    <ImageView
        android:id="@+id/entity_widget_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="设备" />

    <View
        android:id="@+id/entity_widget_online_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/entity_widget_online_dot" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginEnd="5dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/entity_widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#30343B"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/entity_widget_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8B919B"
            android:textSize="8sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/entity_widget_state"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/entity_widget_power"
        android:layout_width="2dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="1dp"
        android:background="@drawable/entity_widget_state_on"
        android:clickable="true"
        android:contentDescription="切换设备"
        android:focusable="true"
        android:text="" />
    </FrameLayout>
</FrameLayout>
